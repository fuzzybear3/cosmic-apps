[Desktop Entry]
Name=Gitea CI Status
Comment=Show Gitea Actions workflow status in the COSMIC panel
Type=Application
Exec=cosmic-applet-github-ci
Terminal=false
Categories=COSMIC;
Keywords=COSMIC;Applet;Gitea;CI;CD;Actions;
Icon=io.github.fuzzybear3.CosmicAppletGithubCi
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
