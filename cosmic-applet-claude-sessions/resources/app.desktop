[Desktop Entry]
Name=Claude Sessions
Comment=Show running Claude Code sessions in the COSMIC panel
Type=Application
Exec=cosmic-applet-claude-sessions
Terminal=false
Categories=COSMIC;
Keywords=COSMIC;Applet;Claude;Sessions;AI;
Icon=io.github.fuzzybear3.CosmicAppletClaudeSessions
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
